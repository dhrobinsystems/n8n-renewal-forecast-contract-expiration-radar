# =====================================================================
# n8n-renewal-forecast-contract-expiration-radar — sample .env
# All values are placeholders. Never commit a filled-in copy of this file.
# =====================================================================

# --- n8n runtime (self-hosted) — lets Code nodes and expressions read $env
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
GENERIC_TIMEZONE=UTC

# --- Safety flags (safe defaults; flip only when promoting to production)
SANDBOX_MODE=true
DRY_RUN=true
RENEWAL_DEALS_CREATION_ENABLED=false
RENEWAL_STAGE_UPDATES_ENABLED=false
MILESTONE_WRITEBACK_ENABLED=false
SEND_SLACK_ALERTS=false
SEND_WEBHOOK_ALERTS=false
ALERT_MIN_SEVERITY=WARNING

# --- HubSpot (secrets: set in your secret manager)
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_API_BASE_URL=https://api.hubapi.com
HUBSPOT_PORTAL_ID=99000001
HUBSPOT_SOURCE_PIPELINE_ID=default
HUBSPOT_SOURCE_CLOSED_WON_STAGE_IDS=closedwon
HUBSPOT_RENEWAL_PIPELINE_ID=880001
HUBSPOT_RENEWAL_CLOSED_STAGE_IDS=880001-won,880001-lost
HUBSPOT_DEAL_COMPANY_ASSOCIATION_TYPE_ID=5
HUBSPOT_MAX_SEARCH_PAGES=50
HUBSPOT_BATCH_SIZE=100

# --- Stage mapping (one per radar window)
RENEWAL_STAGE_90_ID=880001-identified
RENEWAL_STAGE_60_ID=880001-proposal
RENEWAL_STAGE_30_ID=880001-commit

# --- Property mapping
HUBSPOT_CONTRACT_END_DATE_PROPERTY=contract_end_date
HUBSPOT_ARR_PROPERTY=arr
HUBSPOT_RENEWAL_SOURCE_PROPERTY=renewal_source_deal_id
HUBSPOT_RENEWAL_KEY_PROPERTY=renewal_idempotency_key
HUBSPOT_LAST_MILESTONE_PROPERTY=renewal_radar_last_milestone
HUBSPOT_COMPANY_TIER_PROPERTY=customer_tier

# --- Radar rules
RENEWAL_WINDOWS_DAYS=90,60,30
WINDOW_CATCHUP_DAYS=2
RADAR_REFERENCE_DATE=
ENTERPRISE_MIN_ARR=50000
ENTERPRISE_TIER_VALUES=Enterprise,Strategic
RENEWAL_MATCH_TOLERANCE_DAYS=45
RENEWAL_UPLIFT_PCT=0
RENEWAL_DEAL_NAME_TEMPLATE={company_name} - Renewal {contract_end_year}
RENEWAL_CURRENCY=USD
RENEWAL_FALLBACK_OWNER_ID=70000099

# --- Guardrails
MAX_RENEWAL_DEALS_PER_RUN=25
CIRCUIT_BREAKER_MAX_PROPOSED_DEALS=75
CIRCUIT_BREAKER_INVALID_DATE_PCT=20

# --- Alerts (secrets)
SLACK_RENEWAL_WEBHOOK_URL=
ALERT_WEBHOOK_URL=
ALERT_MAX_ITEMS_PER_SECTION=10
